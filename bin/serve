#!/usr/bin/env bash
#
# bin/serve — local preview at http://127.0.0.1:4000, live reload.
# Drafts in _drafts/ ARE visible here (and only here). Ctrl-C to stop.
#
source "$(dirname "$0")/_common.sh"
in_repo

require_cmd bundle

echo "${BOLD}http://127.0.0.1:4000${NC}  (drafts included, ctrl-c to stop)"
echo

exec bundle exec jekyll serve \
  --livereload \
  --drafts \
  --host 127.0.0.1 \
  --port 4000
