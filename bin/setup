#!/usr/bin/env bash
#
# bin/setup — install the build dependencies. Run once per machine.
#
source "$(dirname "$0")/_common.sh"
in_repo

require_cmd ruby
require_cmd bundle

info "installing gems into vendor/bundle (local to this repo, no sudo)"
bundle config set --local path vendor/bundle >/dev/null
bundle install

ok "dependencies installed"
info "next: bin/serve   (to write)  |  bin/new --help   (to start a post)"
